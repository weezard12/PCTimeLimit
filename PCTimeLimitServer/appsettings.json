{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/var/lib/pctimelimit/pctimelimit.db"
  },
  "Security": {
    "JwtIssuer": "pctimelimit-server",
    "JwtAudience": "pctimelimit-clients",
    "JwtSigningKey": "CHANGE_ME_WITH_A_STRONG_RANDOM_SECRET",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "DeviceTokenLifetimeDays": 365,
    "OpsKey": "CHANGE_ME_OPS_KEY"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
