<Window x:Class="PCTimeLimitAdmin.AllowedUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Allowed Usage Editor" Height="520" Width="640" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DaysPanel" Orientation="Vertical" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="90" Height="28" Content="Cancel" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Width="120" Height="28" Content="Save" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

