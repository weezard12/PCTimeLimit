<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <!-- Path to the published child app (generated by publish-all.bat) -->
    <PublishDir>$(MSBuildThisFileDirectory)..\publish\PCTimeLimit</PublishDir>
    <!-- Path to the service binary (generated by publish-all.bat) -->
    <ServicePublishDir>$(MSBuildThisFileDirectory)..\publish\PCTimeLimitService</ServicePublishDir>
    <!-- Make the publish path available to .wxs files as $(var.PublishDir) -->
    <DefineConstants>PublishDir=$(PublishDir);ServicePublishDir=$(ServicePublishDir)</DefineConstants>
    <!-- MSI output name -->
    <OutputName>PCTimeLimitChild</OutputName>
    <!-- Build a 64-bit installer -->
    <InstallerPlatform>x64</InstallerPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="WarnIfPublishMissing" BeforeTargets="Build">
    <Message Importance="high"
             Condition="!Exists('$(PublishDir)\PCTimeLimit.exe')"
             Text="PCTimeLimit publish output not found at '$(PublishDir)'. Run publish-all.bat before building the MSI." />
    <Message Importance="high"
             Condition="!Exists('$(ServicePublishDir)\PCTimeLimitService.exe')"
             Text="PCTimeLimitService binary not found at '$(ServicePublishDir)'. Run publish-all.bat before building the MSI." />
  </Target>
</Project>
