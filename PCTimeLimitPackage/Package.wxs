<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="PC Time Limit (Child)"
    Manufacturer="PC Time Limit"
    Version="1.0.0.0"
    UpgradeCode="{C77AD337-0A39-4BA0-954E-6D1C2DF2E79B}"
    Scope="perMachine"
    Platform="x64">

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />

    <!-- Require elevation and hide ARP change/remove entries to make removal harder -->
    <Property Id="ARPNOREMOVE" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Condition Message="Administrator privileges are required to install or uninstall this product.">
      Privileged
    </Condition>

    <Feature Id="Main" Title="PC Time Limit Child" Level="1">
      <ComponentGroupRef Id="PCTimeLimitComponents" />
    </Feature>
  </Package>
</Wix>
